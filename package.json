{
  "name": "open-autonomy",
  "private": true,
  "description": "A way to run self-building technologies: the platform that funds and shows them, the starter kits that run themselves, the cookbooks, and this install's own boilerplate.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-autonomy-org/open-autonomy.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "sources/supercode-runtime/sdk/typescript",
    "sources/supercode-runtime/sdk/orchestrator",
    "sources/supercode-runtime/sdk/client",
    "sources/supercode-ui/sdk/ui",
    "sources/supercode-ui-development/sdk/client",
    "sources/supercode-ui-development/sdk/terminal",
    "sources/teams/sdk/volter-teams",
    "sources/identity-platform/packages/identity",
    "sources/identity-teams/packages/identity",
    "sources/ztrack",
    "sources/twin-runtime/packages/world-runtime",
    "sources/twin-runtime/packages/world-access",
    "sources/twin-runtime/packages/world-ui",
    "sources/twin-runtime/packages/world-tooling",
    "sources/twin-runtime/packages/twin/discord",
    "sources/twin-runtime/packages/twin/openai",
    "sources/twin-runtime/packages/twin/npm-registry",
    "sources/twin-runtime/packages/twin/stripe",
    "sources/twin-runtime/packages/twin/mongodb",
    "sources/twin-packs/packages/world-core",
    "sources/twin-packs/packages/world-ui",
    "sources/twin-packs/packages/twin/github",
    "sources/twin-packs/packages/twin/polar",
    "sources/twin-ztrack-development/packages/twin/jira"
  ],
  "overrides": {
    "undici": "^7.29.0",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  },
  "scripts": {
    "check": "bun scripts/check.ts",
    "build:sources": "pnpm -r --filter @volter/identity run build && pnpm --filter @volter/ztrack run build:node-cli"
  },
  "devDependencies": {
    "@volter/supercode-harness-sdk": "workspace:0.3.64",
    "@volter/supercode-orchestrator": "workspace:0.5.47",
    "@volter/twin-discord": "workspace:2.0.5",
    "@volter/twin-github": "workspace:2.0.6",
    "@volter/twin-npm-registry": "workspace:2.0.5",
    "@volter/twin-openai": "workspace:2.0.5",
    "@volter/twin-polar": "workspace:2.0.6",
    "@volter/twin-stripe": "workspace:2.0.6",
    "@volter/world-core": "workspace:2.0.6",
    "@volter/world-runtime": "workspace:2.0.8",
    "yaml": "2.9.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.15.0",
      "onFail": "error"
    }
  }
}
