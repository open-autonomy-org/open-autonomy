{
  "name": "open-autonomy",
  "private": true,
  "description": "A way to run self-building technologies: the platform that funds and shows them, the starter kits that run themselves, the cookbooks, and this install's own boilerplate.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-autonomy-org/open-autonomy.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "undici": "^7.29.0",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  },
  "scripts": {
    "check": "bun scripts/check.ts"
  },
  "devDependencies": {
    "@volter/supercode-harness-sdk": "0.3.64",
    "@volter/supercode-orchestrator": "0.5.47",
    "@volter/twin-discord": "^2.0.5",
    "@volter/twin-github": "^2.0.6",
    "@volter/twin-npm-registry": "^2.0.5",
    "@volter/twin-openai": "^2.0.5",
    "@volter/twin-polar": "^2.0.6",
    "@volter/twin-stripe": "^2.0.6",
    "@volter/world-core": "^2.0.6",
    "@volter/world-runtime": "^2.0.8",
    "yaml": "2.9.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.15.0",
      "onFail": "error"
    }
  }
}
