{
  "name": "open-autonomy",
  "private": true,
  "description": "A way to run self-building technologies: the platform that funds and shows them, the starter kits that run themselves, the cookbooks, and this install's own boilerplate.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-autonomy-org/open-autonomy.git"
  },
  "type": "module",
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "undici": "^7.29.0",
    "sharp": "0.35.4"
  },
  "scripts": {
    "check": "bun scripts/check.ts"
  },
  "devDependencies": {
    "@volter/twin": "0.1.2",
    "@volter/twin-discord": "0.1.2",
    "@volter/twin-github": "0.1.2",
    "@volter/twin-npm-registry": "0.1.2",
    "@volter/twin-openai": "0.1.2",
    "@volter/twin-polar": "0.1.2",
    "@volter/twin-stripe": "0.1.2",
    "@volter/twin-world": "0.1.4",
    "@volter-ai-dev/supercode-harness-sdk": "^0.3.26"
  }
}
