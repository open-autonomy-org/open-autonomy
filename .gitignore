node_modules/
*.log
.env
.dev.vars
platform/.dev.vars
.wrangler/

# Hermes home (hermes/): the agent's identity, skills, and schedule are committed; its runtime state is not.
hermes/.env
hermes/auth.json
hermes/*.lock
hermes/state.db*
hermes/sessions/
hermes/logs/
hermes/cache/
hermes/*_cache/
hermes/memories/
hermes/pairing/
hermes/hooks/*
!hermes/hooks/schedule-seed/
!hermes/hooks/schedule-seed/HOOK.yaml
!hermes/hooks/schedule-seed/handler.py
hermes/cron/output/
hermes/cron/*.lock
hermes/__pycache__/
__pycache__/
hermes/bin/
hermes/.update_check
hermes/channel_directory.json
hermes/gateway.pid
hermes/cron/ticker_*
hermes/cron/executions.db
hermes/cron/notepad.db
hermes/.skills_prompt_snapshot.json
# Runtime cron store — rewritten every tick by the scheduler. The committed
# schedule lives in hermes/cron/jobs.seed.json (seeded by the schedule-seed hook).
hermes/cron/jobs.json
hermes/state/
hermes/cron/usage_audit.jsonl
hermes/lsp/
hermes/gateway_state.json
hermes/install_id
hermes/kanban.db
hermes/kanban/
hermes/skills/.bundled_manifest
hermes/skills/.usage.json*
hermes/skills/autonomous-ai-agents/
hermes/verification_evidence.db
hermes/verification_evidence.db
hermes/.restart_pending.json
hermes/reporter-state.json
