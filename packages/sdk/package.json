{
  "name": "@open-autonomy/sdk",
  "version": "2.4.1",
  "description": "The Open Autonomy SDK: the roadmap model and its codec, the development-stream client (sessions, turns, updates), and the key helpers. Everything it does is a documented HTTP wire any language can speak without it.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-autonomy-org/open-autonomy.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./roadmap": "./src/roadmap.ts",
    "./client": "./src/client.ts",
    "./drivers": "./src/drivers.ts",
    "./rails": "./src/rails.ts",
    "./team": "./src/team.ts",
    "./credentials": "./src/credentials.ts",
    "./local-codex": "./src/local-codex.ts",
    "./codex-bridge": "./src/codex-bridge.ts",
    "./codex-host": "./src/codex-host.ts",
    "./reporting": "./src/reporting.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test test/*.test.ts",
    "typecheck": "bunx tsc --noEmit",
    "check": "bun test test/*.test.ts && bunx tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "typescript": "^5.9.0"
  },
  "bin": {
    "open-autonomy-valve": "src/valve.ts",
    "open-autonomy-credentials": "src/credentials.ts"
  },
  "dependencies": {
    "@volter-ai-dev/supercode-harness-sdk": "^0.3.26"
  }
}
