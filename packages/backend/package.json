{
  "name": "@open-autonomy/backend",
  "version": "0.3.0",
  "description": "The backend: one Cloudflare Worker's core that holds each project's funds in an account tree, meters every spend through its rails, carries the development stream and the timeline, and serves a project's page. Open Autonomy's public platform and a private deployment run the same backend.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-autonomy-org/open-autonomy.git",
    "directory": "packages/backend"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./test/env.ts"
  },
  "files": [
    "src",
    "test/env.ts",
    "README.md"
  ],
  "scripts": {
    "test": "bun test test/*.test.ts",
    "typecheck": "bunx tsc --noEmit",
    "check": "bun test test/*.test.ts && bunx tsc --noEmit"
  },
  "dependencies": {
    "@open-autonomy/sdk": "workspace:*",
    "hono": "^4.13.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "typescript": "^5.9.0",
    "wrangler": "4.114.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
