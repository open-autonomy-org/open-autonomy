{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    // The orchestrator package is a dependency of .open-autonomy/ only; its root declarations are read from there
    // (src/supercode-orchestrator.d.ts types the applier's entry points with them).
    "paths": {
      "@volter-ai-dev/supercode-orchestrator": ["../../.open-autonomy/node_modules/@volter-ai-dev/supercode-orchestrator"]
    },
    "types": [
      "bun"
    ]
  },
  "include": [
    "../../.open-autonomy/reporter.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "skews/self-build/.open-autonomy/scrum.ts",
    "base/.open-autonomy/community.ts",
    "base/.open-autonomy/maintain.ts",
    "../../.open-autonomy/start.ts",
    "../../.open-autonomy/host.ts",
    "../../.open-autonomy/reporter.ts"
  ]
}
