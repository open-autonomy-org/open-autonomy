{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "../../.open-autonomy/reporter.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "template/.open-autonomy/scrum.ts",
    "template/.open-autonomy/community.ts",
    "template/.open-autonomy/maintain.ts",
    "../../.open-autonomy/start.ts",
    "../../.open-autonomy/host.ts",
    "../../.open-autonomy/reporter.ts"
  ]
}
