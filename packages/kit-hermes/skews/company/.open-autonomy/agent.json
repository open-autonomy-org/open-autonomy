          "config": {
            "agent.max_turns": 400,
            "approvals.mode": "off"
          }
        }
      },
      "jobs": {
        "report": {
          "schedule": {
            "kind": "cron",
            "expr": "30 0 * * *"
          },
          "prompt": "STRATEGIC REPORT. The day has ended: run the strategy skill exactly, asking nobody.",
          "model": "project",
          "workdir": "{{workspace}}",
          "skills": [
            "strategy"
          ]
        }
      }
    }
  },
  "agents": {
    "box-maintainer": {
      "profile": "box-maintainer",
      "program": "codex",
      "health_alarms": true
    }
  }
}
