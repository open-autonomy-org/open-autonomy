{
  "$schema": "agent.schema.json",
  "harness": "claude-code",
  "profiles": {
    "default": {
      "schema_version": 1,
      "parameters": {
        "workspace": {}
      },
      "inference": {
        "models": {
          "project": {
            "provider": "custom",
            "model": "anthropic/claude-opus-5-5",
            "endpoint": "OPEN_AUTONOMY_BASE_URL",
            "credential": "OPEN_AUTONOMY_KEY",
            "api_mode": "anthropic_messages"
          }
        },
        "default": "project",
        "unattended": "project"
      },
      "extensions": {
        "orchestrator": {
          "config": {
            "agent.max_turns": 400,
            "approvals.mode": "off"
          }
        }
      }
    },
    "manager": {
      "schema_version": 1,
      "parameters": {
        "workspace": {}
      },
      "inference": {
        "models": {
          "project": {
            "provider": "custom",
            "model": "anthropic/claude-opus-5-5",
            "endpoint": "OPEN_AUTONOMY_BASE_URL",
            "credential": "OPEN_AUTONOMY_KEY",
            "api_mode": "anthropic_messages"
          }
        },
        "default": "project",
        "unattended": "project"
      },
      "extensions": {
        "orchestrator": {
          "config": {
            "agent.max_turns": 400,
            "approvals.mode": "off"
          }
        }
      },
      "jobs": {
        "tick": {
          "schedule": {
            "kind": "interval",
            "minutes": 30
          },
          "prompt": "MANAGER TICK. Run the manager skill's tick exactly.",
          "model": "project",
          "workdir": "{{workspace}}",
          "skills": [
            "manager"
          ]
        }
      }
    },
    "gtm-manager": {
      "schema_version": 1,
      "parameters": {
        "workspace": {}
      },
      "inference": {
        "models": {
          "project": {
            "provider": "custom",
            "model": "anthropic/claude-opus-5-5",
            "endpoint": "OPEN_AUTONOMY_BASE_URL",
            "credential": "OPEN_AUTONOMY_KEY",
            "api_mode": "anthropic_messages"
          }
        },
        "default": "project",
        "unattended": "project"
      },
      "extensions": {
        "orchestrator": {
          "config": {
            "agent.max_turns": 400,
            "approvals.mode": "off"
          }
        }
      },
      "jobs": {
        "clock": {
          "schedule": {
            "kind": "interval",
            "minutes": 30
          },
          "script": "clock.sh",
          "no_agent": true,
          "prompt": "GTM MANAGER CLOCK: the clock.sh script wakes the GTM manager's own session with its tick; no model turn."
        }
      }
    },
    "account-manager": {
      "schema_version": 1,
      "parameters": {
        "workspace": {}
      },
      "inference": {
        "models": {
          "project": {
            "provider": "custom",
            "model": "anthropic/claude-opus-5-5",
            "endpoint": "OPEN_AUTONOMY_BASE_URL",
            "credential": "OPEN_AUTONOMY_KEY",
            "api_mode": "anthropic_messages"
          }
        },
        "default": "project",
        "unattended": "project"
      },
      "extensions": {
        "orchestrator": {
          "config": {
            "agent.max_turns": 400,
            "approvals.mode": "off"
          }
        }
      },
      "jobs": {
        "digest": {
          "schedule": {
            "kind": "interval",
            "minutes": 1440
          },
          "prompt": "DIGEST. Write the principal's digest: what reached done, what is blocked and why, what needs their word; every claim with its source.",
          "model": "project",
          "workdir": "{{workspace}}"
        }
      }
    },
    "coder": {
      "schema_version": 1,
      "parameters": {
        "workspace": {}
      },
      "inference": {
        "models": {
          "project": {
            "provider": "custom",
            "model": "anthropic/claude-opus-5-5",
            "endpoint": "OPEN_AUTONOMY_BASE_URL",
            "credential": "OPEN_AUTONOMY_KEY",
            "api_mode": "anthropic_messages"
          }
        },
        "default": "project",
        "unattended": "project"
      },
      "extensions": {
        "orchestrator": {
          "config": {
            "agent.max_turns": 400,
            "approvals.mode": "off"
          }
        }
      }
    },
    "coder-codex": {
      "schema_version": 1,
      "parameters": {
        "workspace": {}
      },
      "inference": {
        "models": {
          "project": {
            "provider": "openai-codex",
            "model": "gpt-6-sol"
          }
        },
        "default": "project",
        "unattended": "project"
      },
      "extensions": {
        "orchestrator": {
          "config": {
            "agent.max_turns": 400,
            "approvals.mode": "off",
            "worker.harness": "codex"
          }
        }
      }
    },
    "coder-claude": {
      "schema_version": 1,
      "parameters": {
        "workspace": {}
      },
      "inference": {
        "models": {
          "project": {
            "provider": "custom",
            "model": "anthropic/claude-opus-5-5",
            "endpoint": "OPEN_AUTONOMY_BASE_URL",
            "credential": "OPEN_AUTONOMY_KEY",
            "api_mode": "anthropic_messages"
          }
        },
        "default": "project",
        "unattended": "project"
      },
      "extensions": {
        "orchestrator": {
          "config": {
            "agent.max_turns": 400,
            "approvals.mode": "off",
            "worker.harness": "claude-code"
          }
        }
      }
    },
    "reviewer": {
      "schema_version": 1,
      "parameters": {
        "workspace": {}
      },
      "inference": {
        "models": {
          "project": {
            "provider": "custom",
            "model": "anthropic/claude-opus-5-5",
            "endpoint": "OPEN_AUTONOMY_BASE_URL",
            "credential": "OPEN_AUTONOMY_KEY",
            "api_mode": "anthropic_messages"
          }
        },
        "default": "project",
        "unattended": "project"
      },
      "extensions": {
        "orchestrator": {
          "config": {
            "agent.max_turns": 400,
            "approvals.mode": "off"
          }
        }
      }
    },
    "auditor": {
      "schema_version": 1,
      "parameters": {
        "workspace": {}
      },
      "inference": {
        "models": {
          "project": {
            "provider": "openai-codex",
            "model": "gpt-6-sol"
          }
        },
        "default": "project",
        "unattended": "project"
      },
      "extensions": {
        "orchestrator": {
          "config": {
            "agent.max_turns": 400,
            "approvals.mode": "off",
            "worker.harness": "codex"
          }
        }
      },
      "jobs": {
        "round": {
          "schedule": {
            "kind": "interval",
            "minutes": 60
          },
          "prompt": "AUDIT ROUND. Audit the last hour's acts in full against the written rules; send the findings, each with act, rule and source, to the account manager.",
          "model": "project",
          "workdir": "{{workspace}}"
        }
      }
    },
    "box-maintainer": {
      "schema_version": 1,
      "parameters": {
        "workspace": {}
      },
      "inference": {
        "models": {
          "project": {
            "provider": "openai-codex",
            "model": "gpt-6-sol"
          }
        },
        "default": "project",
        "unattended": "project"
      },
      "extensions": {
        "orchestrator": {
          "config": {
            "agent.max_turns": 400,
            "approvals.mode": "off",
            "worker.harness": "codex"
          }
        }
      },
      "jobs": {
        "pass": {
          "schedule": {
            "kind": "interval",
            "minutes": 60
          },
          "prompt": "FLEET PASS: pass.sh files a turn to the single box-maintainer main session. Clear disk first, then inspect resources, hangs and working-session outages across every enrolled machine.",
          "script": "pass.sh",
          "no_agent": true
        }
      }
    },
    "gtm-auditor": {
      "schema_version": 1,
      "parameters": {
        "workspace": {}
      },
      "inference": {
        "models": {
          "project": {
            "provider": "custom",
            "model": "anthropic/claude-opus-5-5",
            "endpoint": "OPEN_AUTONOMY_BASE_URL",
            "credential": "OPEN_AUTONOMY_KEY",
            "api_mode": "anthropic_messages"
          }
        },
        "default": "project",
        "unattended": "project"
      },
      "extensions": {
        "orchestrator": {
          "config": {
            "agent.max_turns": 400,
            "approvals.mode": "off"
          }
        }
      }
    },
    "walker": {
      "schema_version": 1,
      "parameters": {
        "workspace": {}
      },
      "inference": {
        "models": {
          "project": {
            "provider": "custom",
            "model": "anthropic/claude-opus-5-5",
            "endpoint": "OPEN_AUTONOMY_BASE_URL",
            "credential": "OPEN_AUTONOMY_KEY",
            "api_mode": "anthropic_messages"
          }
        },
        "default": "project",
        "unattended": "project"
      },
      "extensions": {
        "orchestrator": {
          "config": {
            "agent.max_turns": 400,
            "approvals.mode": "off"
          }
        }
      }
    },
    "strategy": {
      "schema_version": 1,
      "parameters": {
        "workspace": {}
      },
      "inference": {
        "models": {
          "project": {
            "provider": "custom",
            "model": "anthropic/claude-opus-5-5",
            "endpoint": "OPEN_AUTONOMY_BASE_URL",
            "credential": "OPEN_AUTONOMY_KEY",
            "api_mode": "anthropic_messages"
          }
        },
        "default": "project",
        "unattended": "project"
      },
      "extensions": {
