{
  "profiles": {
    "default": {
      "schema_version": 1,
      "parameters": {
        "workspace": {}
      },
      "inference": {
        "models": {
          "project": {
            "provider": "custom",
            "model": "zai/glm-5.3-flash",
            "endpoint": "OPEN_AUTONOMY_BASE_URL",
            "credential": "OPEN_AUTONOMY_KEY",
            "api_mode": "chat_completions"
          }
        },
        "default": "project",
        "unattended": "project"
      },
      "extensions": {
        "hermes": {
          "config": {
            "terminal.backend": "local",
            "terminal.timeout": 300,
            "memory.memory_enabled": false,
            "memory.user_profile_enabled": false,
            "compression.enabled": true,
            "compression.threshold": 0.5,
            "agent.max_turns": 160,
            "kanban.dispatch_interval_seconds": 15,
            "kanban.review_dispatch": true,
            "agent.disabled_toolsets": [
              "browser-use"
            ]
          }
        }
      },
      "jobs": {
        "pm": {
          "schedule": {
            "kind": "interval",
            "minutes": 1440
          },
          "prompt": "WAKE: PM. Run the pm skill: read what landed and what was asked since the last scrum, reconcile ROADMAP.md and CHANGELOG.md, name what is stalled, ask the people who own it, and reassess the release proposal.",
          "skills": [
            "pm"
          ],
          "model": "project",
          "workdir": "{{workspace}}"
        }
      }
    },
    "treasurer": {
      "schema_version": 1,
      "inference": {
        "models": {
          "project": {
            "provider": "custom",
            "model": "zai/glm-5.3-flash",
            "endpoint": "OPEN_AUTONOMY_PAY_URL",
            "placeholder_key": "valve",
            "api_mode": "chat_completions"
          }
        },
        "default": "project",
        "unattended": "project"
      },
      "extensions": {
        "hermes": {
          "config": {
            "terminal.backend": "local",
            "terminal.timeout": 300,
            "memory.memory_enabled": false,
            "memory.user_profile_enabled": false,
            "compression.enabled": true,
            "compression.threshold": 0.5,
            "agent.max_turns": 80,
            "kanban.dispatch_interval_seconds": 15,
            "kanban.review_dispatch": true
          }
        }
      }
    }
  }
}
