{
  "name": "create-open-autonomy",
  "version": "3.26.21",
  "description": "Open Autonomy starter kits: complete owner-run Hermes and native IR repositories with the SDK wired in. `pnpm --config.cacheDir=\"$(dirname \"$(pnpm store path)\")/cache\" --config.nodeLinker=hoisted --config.package-import-method=hardlink dlx create-open-autonomy <dir>` scaffolds one.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-autonomy-org/open-autonomy.git",
    "directory": "packages/kit-hermes"
  },
  "type": "module",
  "bin": {
    "create-open-autonomy": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/kit.ts",
    "./keeper": "./keeper/start.ts"
  },
  "files": [
    "src",
    "keeper",
    "records",
    "base",
    "skews",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@open-autonomy/sdk": "workspace:4.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "typescript": "^5.9.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.15.0",
      "onFail": "error"
    }
  }
}
