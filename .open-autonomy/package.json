{
  "name": "open-autonomy-host",
  "private": true,
  "type": "module",
  "description": "The project's channel and World dependencies. Fleet and Agent are separate installed machine programs, selected through their public installed SDKs in machine-supercode.ts. The Open Autonomy SDK is vendored beside these host tools under sdk/.",
  "dependencies": {
    "chat": "4.39.0",
    "@chat-adapter/discord": "4.39.0",
    "@chat-adapter/state-memory": "4.39.0",
    "@volter/world-core": "workspace:2.0.15",
    "@volter/world-runtime": "workspace:2.0.26",
    "@volter/twin-github": "workspace:2.0.17",
    "@volter/twin-openai": "workspace:2.0.15",
    "@volter/twin-discord": "workspace:2.0.15",
    "@volter/twin-jira": "workspace:2.0.15",
    "@volter/twin-slack": "workspace:2.0.15"
  },
  "packageManager": "pnpm@12.15.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.15.0",
      "onFail": "error"
    }
  }
}
