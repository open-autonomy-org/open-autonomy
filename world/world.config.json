{
  "schemaVersion": 2,
  "metadata": {
    "id": "open-autonomy-todo-cli",
    "description": "Open Autonomy scenario: synthetic vendors, real platform and native cookbook agent. World owns all service lifetimes."
  },
  "discovery": {
    "selection": {
      "include": [
        {
          "usage": "application"
        },
        {
          "usage": "dependencies"
        },
        {
          "usage": "build"
        },
        {
          "usage": "deployment"
        }
      ],
      "exclude": []
    }
  },
  "runtime": {
    "environment": {
      "values": {
        "AGENT_PROXY_ADMIN_TOKEN": "world-admin",
        "AGENT_PROXY_HMAC_SECRET": "world-hmac-secret",
        "MODEL_GATEWAY_API_KEY": "world-gateway-key",
        "OPEN_AUTONOMY_MODEL": "zai/glm-5.3-flash"
      },
      "strip": [
        "*"
      ]
    }
  },
  "services": [
    {
      "id": "gateway",
      "type": "twin",
      "execution": {
        "process": {
          "command": "bun",
          "args": [
            "${TWIN:openai}",
            "serve"
          ]
        },
        "environment": {
          "values": {
            "TWIN_OPENAI_SCENARIO": "${HANDLERS}"
          }
        }
      },
      "endpoint": {
        "port": "auto"
      },
      "bindings": {
        "injectEnv": "GATEWAY_TWIN_URL"
      }
    },
    {
      "id": "github",
      "type": "twin",
      "execution": {
        "process": {
          "command": "bun",
          "args": [
            "${TWIN:github}",
            "serve"
          ]
        }
      },
      "endpoint": {
        "port": "auto"
      },
      "bindings": {
        "injectEnv": "GITHUB_TWIN_URL"
      }
    },
    {
      "id": "discord",
      "type": "twin",
      "execution": {
        "process": {
          "command": "bun",
          "args": [
            "${TWIN:discord}",
            "serve"
          ]
        }
      },
      "endpoint": {
        "port": "auto"
      },
      "bindings": {
        "injectEnv": "DISCORD_TWIN_URL"
      }
    },
    {
      "id": "stripe",
      "type": "twin",
      "execution": {
        "process": {
          "command": "bun",
          "args": [
            "${TWIN:stripe}",
            "serve"
          ]
        }
      },
      "endpoint": {
        "port": "auto"
      },
      "bindings": {
        "injectEnv": "STRIPE_TWIN_URL"
      }
    },
    {
      "id": "polar",
      "type": "twin",
      "execution": {
        "process": {
          "command": "bun",
          "args": [
            "${TWIN:polar}",
            "serve"
          ]
        }
      },
      "endpoint": {
        "port": "auto"
      },
      "bindings": {
        "injectEnv": "POLAR_TWIN_URL"
      }
    },
    {
      "id": "npm",
      "type": "twin",
      "execution": {
        "process": {
          "command": "bun",
          "args": [
            "${TWIN:npm-registry}",
            "serve"
          ]
        }
      },
      "endpoint": {
        "port": "auto"
      },
      "bindings": {
        "injectEnv": "NPM_REGISTRY_TWIN_URL"
      }
    },
    {
      "id": "live",
      "type": "process",
      "execution": {
        "process": {
          "command": "bun",
          "args": [
            "${SCENARIO_DIR}/live.ts"
          ],
          "rootArg": false,
          "portArg": false
        }
      },
      "endpoint": {
        "port": "auto",
        "ready": {
          "httpUrl": "${url}/api",
          "timeoutMs": 30000,
          "intervalMs": 200
        }
      },
      "bindings": {
        "injectEnv": "LIVE_SERVICE_URL"
      }
    },
    {
      "id": "platform",
      "type": "process",
      "execution": {
        "process": {
          "command": "bun",
          "args": [
            "${TREE}/apps/platform/world.ts"
          ],
          "rootArg": "--persist-to",
          "portArg": false
        },
        "environment": {
          "values": {
            "OPEN_AUTONOMY_ACCOUNT": "cookbook/todo-cli"
          }
        }
      },
      "endpoint": {
        "port": "auto",
        "ready": {
          "httpUrl": "${url}/healthz",
          "timeoutMs": 120000,
          "intervalMs": 500
        }
      },
      "bindings": {
        "injectEnv": "PLATFORM_URL"
      }
    },
    {
      "id": "actions",
      "type": "process",
      "execution": {
        "process": {
          "command": "bun",
          "args": [
            "${SCENARIO_DIR}/actions.ts"
          ],
          "rootArg": false,
          "portArg": false
        }
      },
      "endpoint": {
        "port": "auto",
        "ready": {
          "httpUrl": "${url}/healthz",
          "timeoutMs": 30000,
          "intervalMs": 200
        }
      },
      "bindings": {
        "injectEnv": "ACTIONS_URL"
      }
    },
    {
      "id": "agent",
      "type": "process",
      "execution": {
        "process": {
          "command": "sh",
          "args": [
            "${SCENARIO_DIR}/agent.sh"
          ],
          "rootArg": false,
          "portArg": false
        }
      },
      "endpoint": {
        "port": 18787,
        "portReason": "The existing OA entrypoint uses this port and the next three for its valves and webhook listener; choose OA_VALVE_PORT for another instance.",
        "ready": {
          "command": "bun",
          "args": [
            "${SCENARIO_DIR}/ready.ts"
          ],
          "timeoutMs": 300000,
          "intervalMs": 1000
        }
      },
      "bindings": {
        "injectEnv": "OA_AGENT_URL"
      }
    }
  ]
}
