{
  "id": "open-autonomy",
  "description": "Open Autonomy with no keys anywhere: the real platform worker under wrangler dev, metering against the openai twin as the model gateway, syncing docs and minting keys against the GitHub twin. The agent (real Hermes) runs against it with `bun world/run.ts env -- …`. ${TWINS_ROOT} and ${WORLD_DIR} are substituted by world/run.ts into an ignored generated copy.",
  "env": {
    "AGENT_PROXY_ADMIN_TOKEN": "world-admin",
    "AGENT_PROXY_HMAC_SECRET": "world-hmac-secret",
    "MODEL_GATEWAY_API_KEY": "world-gateway-key",
    "OPEN_AUTONOMY_ACCOUNT": "open-autonomy-org/open-autonomy",
    "OPEN_AUTONOMY_MODEL": "deepseek/deepseek-v4-flash"
  },
  "services": [
    {
      "id": "openai",
      "type": "twin",
      "command": "bun",
      "args": ["${TWINS_ROOT}/packages/twin/openai/src/cli.ts", "serve"],
      "port": "auto",
      "injectEnv": "OPENAI_TWIN_URL",
      "env": { "TWIN_OPENAI_SCENARIO": "${WORLD_DIR}/handlers/openai.json" }
    },
    {
      "id": "github",
      "type": "twin",
      "command": "bun",
      "args": ["${TWINS_ROOT}/packages/twin/github/src/cli.ts", "serve"],
      "port": "auto",
      "injectEnv": "GITHUB_TWIN_URL"
    },
    {
      "id": "platform",
      "type": "process",
      "command": "bun",
      "args": ["world/platform.ts"],
      "port": "auto",
      "portArg": false,
      "rootArg": "--persist-to",
      "injectEnv": "PLATFORM_URL",
      "ready": { "httpUrl": "${url}/healthz", "timeoutMs": 120000, "intervalMs": 500 }
    }
  ]
}
