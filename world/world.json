{
  "id": "open-autonomy",
  "description": "Open Autonomy's world: the platform worker built from this tree, against the openai twin as the model gateway and the GitHub twin. Cookbooks are the projects under test: the template applied to cookbook/<name>, pushed to the twin, funded and keyed on the world's platform, run once, and audited from twin state and the books. ${TWINS_ROOT} and ${WORLD_DIR} are substituted by world/run.ts into an ignored generated copy.",
  "env": {
    "AGENT_PROXY_ADMIN_TOKEN": "world-admin",
    "AGENT_PROXY_HMAC_SECRET": "world-hmac-secret",
    "MODEL_GATEWAY_API_KEY": "world-gateway-key",
    "OPEN_AUTONOMY_ACCOUNT": "cookbook/hello-roadmap",
    "OPEN_AUTONOMY_MODEL": "deepseek/deepseek-v4-flash"
  },
  "services": [
    {
      "id": "openai",
      "type": "twin",
      "command": "bun",
      "args": [
        "${TWINS_ROOT}/packages/twin/openai/src/cli.ts",
        "serve"
      ],
      "port": "auto",
      "injectEnv": "OPENAI_TWIN_URL",
      "env": {
        "TWIN_OPENAI_SCENARIO": "${WORLD_DIR}/handlers/openai.json"
      }
    },
    {
      "id": "github",
      "type": "twin",
      "command": "bun",
      "args": [
        "${TWINS_ROOT}/packages/twin/github/src/cli.ts",
        "serve"
      ],
      "port": "auto",
      "injectEnv": "GITHUB_TWIN_URL"
    },
    {
      "id": "platform",
      "type": "process",
      "command": "bun",
      "args": [
        "world/platform.ts"
      ],
      "port": "auto",
      "portArg": false,
      "rootArg": "--persist-to",
      "injectEnv": "PLATFORM_URL",
      "ready": {
        "httpUrl": "${url}/healthz",
        "timeoutMs": 120000,
        "intervalMs": 500
      }
    },
    {
      "id": "sidecar",
      "type": "process",
      "command": "bun",
      "args": [
        "template/sidecar/agent-sidecar.ts"
      ],
      "port": "auto",
      "portArg": "--port",
      "rootArg": false,
      "injectEnv": "SIDECAR_URL",
      "env": {
        "AGENT_ENV_FILE": "${WORLD_DIR}/../.volter/worlds/open-autonomy/data/agent.env",
        "OPEN_AUTONOMY_BASE_URL": "",
        "OPEN_AUTONOMY_NARRATE_SESSIONS": "all"
      },
      "ready": {
        "httpUrl": "${url}/healthz",
        "timeoutMs": 30000,
        "intervalMs": 200
      }
    }
  ]
}
