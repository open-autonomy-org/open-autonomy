{
  "id": "open-autonomy",
  "description": "Open Autonomy's world: the platform worker built from this tree, metering against the model gateway (the openai twin playing the gateway's OpenAI wire, scripted by the cookbook's scenario) and the GitHub twin. Cookbooks are the projects under test; nothing in the world calls a real API. ${TWINS_ROOT}, ${WORLD_DIR} and ${SCENARIO} are substituted by world/run.ts into an ignored generated copy.",
  "env": {
    "AGENT_PROXY_ADMIN_TOKEN": "world-admin",
    "AGENT_PROXY_HMAC_SECRET": "world-hmac-secret",
    "MODEL_GATEWAY_API_KEY": "world-gateway-key",
    "OPEN_AUTONOMY_MODEL": "deepseek/deepseek-v4-flash"
  },
  "services": [
    {
      "id": "gateway",
      "type": "twin",
      "command": "bun",
      "args": [
        "${TWINS_ROOT}/packages/twin/openai/src/cli.ts",
        "serve"
      ],
      "port": "auto",
      "injectEnv": "GATEWAY_TWIN_URL",
      "env": {
        "TWIN_OPENAI_SCENARIO": "${SCENARIO}"
      }
    },
    {
      "id": "github",
      "type": "twin",
      "command": "bun",
      "args": [
        "${TWINS_ROOT}/packages/twin/github/src/cli.ts",
        "serve"
      ],
      "port": "auto",
      "injectEnv": "GITHUB_TWIN_URL"
    },
    {
      "id": "platform",
      "type": "process",
      "command": "bun",
      "args": [
        "world/platform.ts"
      ],
      "port": "auto",
      "portArg": false,
      "rootArg": "--persist-to",
      "injectEnv": "PLATFORM_URL",
      "ready": {
        "httpUrl": "${url}/healthz",
        "timeoutMs": 120000,
        "intervalMs": 500
      }
    },
    {
      "id": "sidecar",
      "type": "process",
      "command": "bun",
      "args": [
        "template/sidecar/agent-sidecar.ts"
      ],
      "port": "auto",
      "portArg": "--port",
      "rootArg": false,
      "injectEnv": "SIDECAR_URL",
      "env": {
        "AGENT_ENV_FILE": "${WORLD_DIR}/../.volter/worlds/open-autonomy/data/agent.env",
        "OPEN_AUTONOMY_BASE_URL": "",
        "OPEN_AUTONOMY_NARRATE_SESSIONS": "all"
      },
      "ready": {
        "httpUrl": "${url}/healthz",
        "timeoutMs": 30000,
        "intervalMs": 200
      }
    }
  ]
}
