{
  "profiles": {
    "default": {
      "schema_version": 1,
      "parameters": {
        "workspace": {}
      },
      "inference": {
        "models": {
          "project": {
            "provider": "custom",
            "model": "zai/glm-5.3-flash",
            "endpoint": "OPEN_AUTONOMY_BASE_URL",
            "credential": "OPEN_AUTONOMY_KEY",
            "api_mode": "chat_completions"
          }
        },
        "default": "project",
        "unattended": "project"
      },
      "extensions": {
        "hermes": {
          "config": {
            "terminal.backend": "local",
            "terminal.shell_init_files": [
              "/opt/hermes/.venv/bin/activate"
            ],
            "terminal.timeout": 300,
            "memory.memory_enabled": false,
            "memory.user_profile_enabled": false,
            "compression.enabled": true,
            "compression.threshold": 0.5,
            "agent.max_turns": 80,
            "agent.disabled_toolsets": [
              "browser-use"
            ],
            "kanban.dispatch_interval_seconds": 15,
            "kanban.review_dispatch": true
          }
        }
      },
      "jobs": {
        "pm": {
          "schedule": {
            "kind": "interval",
            "minutes": 60
          },
          "prompt": "WAKE: PM. You are this project's PM for the hour. Run the pm skill: read the board, unstick what is stuck, report.",
          "skills": [
            "pm"
          ],
          "deliver": "discord",
          "model": "project",
          "workdir": "{{workspace}}"
        }
      }
    },
    "treasurer": {
      "schema_version": 1,
      "inference": {
        "models": {
          "project": {
            "provider": "custom",
            "model": "zai/glm-5.3-flash",
            "endpoint": "OPEN_AUTONOMY_PAY_URL",
            "placeholder_key": "valve",
            "api_mode": "chat_completions"
          }
        },
        "default": "project",
        "unattended": "project"
      },
      "extensions": {
        "hermes": {
          "config": {
            "terminal.backend": "local",
            "terminal.shell_init_files": [
              "/opt/hermes/.venv/bin/activate"
            ],
            "terminal.timeout": 300,
            "memory.memory_enabled": false,
            "memory.user_profile_enabled": false,
            "compression.enabled": true,
            "compression.threshold": 0.5,
            "agent.max_turns": 80,
            "kanban.dispatch_interval_seconds": 15,
            "kanban.review_dispatch": true
          }
        }
      }
    }
  }
}
