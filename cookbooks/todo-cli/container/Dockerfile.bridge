# The bridge: everything the agent may use but must not possess. One container, three processes: the valve (the
# project's keys, one port each), an ssh-agent holding the deploy key (its socket shared with the agent), and the
# reporter (keyless; reads the agent's home through supercode and publishes through the valve). bun for the valve and
# the reporter, openssh for the agent; the reporter's two npm dependencies (supercode, its harness SDK) baked in.
FROM oven/bun:1.3.10
USER root
RUN apt-get update && apt-get install -y --no-install-recommends openssh-client && rm -rf /var/lib/apt/lists/*
COPY .open-autonomy /opt/bridge
COPY container/bridge.sh /opt/bridge/bridge.sh
WORKDIR /opt/bridge
RUN bun install --no-save && chmod +x /opt/bridge/bridge.sh && ./node_modules/.bin/supercode --version
ENV PATH="/opt/bridge/node_modules/.bin:${PATH}"
CMD ["/opt/bridge/bridge.sh"]
