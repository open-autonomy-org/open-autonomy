# Native port forwarding over host-owned `docker exec -i`, as hermes.
# Invoke sshd with -i: this configuration does not start a network listener.
HostKey /opt/data/.open-autonomy-transport/host_key
AuthorizedKeysFile /opt/data/.open-autonomy-transport/authorized_keys
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM no
AllowUsers hermes
AllowAgentForwarding no
X11Forwarding no
PermitTTY no
PermitUserRC no
PermitUserEnvironment no
MaxSessions 0
AllowTcpForwarding yes
AllowStreamLocalForwarding no
GatewayPorts no
PermitOpen 127.0.0.1:51216
PermitListen 127.0.0.1:8787 127.0.0.1:8788 127.0.0.1:8789 127.0.0.1:8790
LogLevel ERROR
